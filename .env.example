# Скопируйте в .env и заполните: cp .env.example .env
# Пустые значения не учитываются. Переменные окружения важнее этого файла.

# Токен бота от @BotFather. Без него уведомления в Telegram выключены.
TELEGRAM_BOT_TOKEN=

# Час утренней сводки по времени сервера (0–23).
TELEGRAM_DIGEST_HOUR=9

# Адрес доски, например http://192.168.1.10:8000. Если задан, ссылка добавляется в сообщения.
TODO_PUBLIC_URL=

# Адрес прокси перед доской: только ему можно передавать адрес посетителя.
FORWARDED_ALLOW_IPS=

# Адреса и подсети через запятую, которым можно открывать доску, например
# 192.168.33.0/24,10.189.0.0/16. Пусто — всем. За прокси нужен и FORWARDED_ALLOW_IPS.
TODO_ALLOWED_NETWORKS=

# Вход через Google: OAuth-клиент из Google Cloud Console. Нужен и TODO_PUBLIC_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Вход по паролю (true/false).
TODO_PASSWORD_LOGIN=true

# Путь к базе SQLite.
TODO_DB=data/tasks.db

# Вход через LDAP или Active Directory. Без LDAP_URL выключен. Примеры — в README.
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Фильтр поиска, обязательно с {username}. Пример для LLDAP с группой:
# LDAP_USER_FILTER=(&(uid={username})(memberOf=cn=board_users,ou=groups,dc=example,dc=com))
LDAP_USER_FILTER=
LDAP_LOGIN_ATTR=
LDAP_NAME_ATTR=
# Корневой сертификат для ldaps://, в compose это файл из папки ./certs.
LDAP_CA_FILE=
# true: не проверять сертификат сервера. Пароли можно перехватить, лучше указать LDAP_CA_FILE.
LDAP_TLS_INSECURE=
# true: привязать к каталогу уже заведённых людей с таким же логином.
LDAP_LINK_EXISTING=

# Версия готового образа для docker compose. Пусто — latest.
TAG=

# Адрес и порт сервера.
HOST=0.0.0.0
PORT=8000
