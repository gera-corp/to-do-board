{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "config",
    "vault",
    "ingress",
    "persistence"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "telegramDigestHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "publicUrl": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "sqliteJournalMode": {
          "enum": [
            "WAL",
            "DELETE",
            "TRUNCATE"
          ]
        },
        "cookieSecure": {
          "type": "boolean"
        },
        "passwordLogin": {
          "type": "boolean"
        },
        "googleClientId": {
          "type": "string",
          "pattern": "^([0-9A-Za-z-]+\\.apps\\.googleusercontent\\.com)?$"
        },
        "trustedProxies": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "vault": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretPath": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "addr": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "authPath": {
          "type": "string"
        },
        "skipVerify": {
          "type": "string",
          "enum": [
            "",
            "true",
            "false"
          ]
        },
        "reloadOnSecretChange": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        },
        "existingClaim": {
          "type": "string"
        },
        "keepOnUninstall": {
          "type": "boolean"
        }
      }
    }
  }
}
